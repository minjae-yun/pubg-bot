#디스코드 봇 토큰
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1529669510259282110
DISCORD_GUILD_ID=여기에_테스트_서버_ID


PUBG_API_KEY=여기에_PUBG_API_키

# 기본값은 PC/Steam입니다.
PUBG_PLATFORM=steam

# 비워두면 모든 채널에서 사용할 수 있습니다.
ALLOWED_CHANNEL_ID=

# 같은 닉네임의 조회 결과를 보관할 시간(초)
CACHE_TTL_SECONDS=120

# 등록된 플레이어와 파티 기록을 저장할 SQLite 파일
DATABASE_PATH=data/bot.sqlite

# 사녹 원본 텔레메트리를 압축 저장할 폴더
TELEMETRY_ARCHIVE_PATH=data/telemetry

# 킬내기 Google 시트 자동 입력(ID와 서비스 계정 키 경로가 필요합니다.)
KILL_RACE_SHEET_ID=
# 비워도 되며, 비우면 Sheet ID로 주소를 자동 생성합니다.
KILL_RACE_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=secrets/google-service-account.json

# PUBG API에 끝난 경기가 올라왔는지 확인하는 주기(초)
KILL_RACE_AUTO_REFRESH_SECONDS=60

# 개발 중에는 false를 유지하세요. true이면 명령어를 전역 등록합니다.
REGISTER_GLOBALLY=false

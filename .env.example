#디스코드 봇 토큰
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1529669510259282110
DISCORD_GUILD_ID=여기에_테스트_서버_ID


PUBG_API_KEY=여기에_PUBG_API_키

# 기본값은 PC/Steam입니다.
PUBG_PLATFORM=steam

# 비워두면 모든 채널에서 사용할 수 있습니다.
ALLOWED_CHANNEL_ID=

# 같은 닉네임의 조회 결과를 보관할 시간(초)
CACHE_TTL_SECONDS=120

# 등록된 플레이어와 파티 기록을 저장할 SQLite 파일
DATABASE_PATH=data/bot.sqlite

# 개발 중에는 false를 유지하세요. true이면 명령어를 전역 등록합니다.
REGISTER_GLOBALLY=false
